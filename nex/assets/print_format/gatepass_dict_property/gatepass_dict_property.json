 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <title>Simple Jinja Template</title>\r\n</head>\r\n<body>\r\n    <h1>Welcome!</h1>\r\n\r\n    <p>Document Name: {{ doc.name }}</p>\r\n    <p>Document Type: {{ doc.doctype }}</p>\r\n    <p>Transaction Date: {{ doc.transaction_date }}</p>\r\n\r\n    {% if doc.customer %}\r\n        <p>Customer: {{ doc.customer }}</p>\r\n    {% else %}\r\n        <p>No customer associated with this document.</p>\r\n    {% endif %}\r\n\r\n    <h2>Items:</h2>\r\n    {% if doc.items %}\r\n        <ul>\r\n            {% for item in doc.items %}\r\n                <li>\r\n                    Item Name: {{ item.item_name }}, Quantity: {{ item.qty }}\r\n                </li>\r\n            {% endfor %}\r\n        </ul>\r\n    {% else %}\r\n        <p>No items found.</p>\r\n    {% endif %}\r\n\r\n    <script>\r\n        console.log(\"Document Data:\", {{ doc | safe }});\r\n    </script>\r\n</body>\r\n</html>",
