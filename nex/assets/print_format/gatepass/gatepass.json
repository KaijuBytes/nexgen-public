 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;\">\r\n    <style>\r\n        @import url('https://fonts.googleapis.com/css2?family=Palatino&display=swap');\r\n        \r\n        body {\r\n            font-family: 'Palatino', serif;\r\n            margin: 0;\r\n            padding: 0;\r\n            font-size: 12px; /* Adjust this size to match your desired body font size */\r\n        }\r\n        .docstatus-draft {\r\n            position: absolute;\r\n            top: 50%;\r\n            left: 50%;\r\n            transform: translate(-50%, -50%) rotate(-45deg);\r\n            font-size: 10rem;\r\n            color: red;\r\n            opacity: 0.5;\r\n            pointer-events: none;\r\n        }\r\n        \r\n        \r\n        .header {\r\n            text-align: center;\r\n            font-weight: bold;\r\n            margin-bottom: 20px;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif; /* Use Palatino Linotype font */\r\n            font-weight: bold; /* Make the text extra bold */\r\n        }\r\n        \r\n        .section-title {\r\n            /*font-weight: bold;*/\r\n            margin-top: 20px;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif; /* Use Palatino Linotype font */\r\n            font-weight: bold; /* Make the text extra bold */\r\n        }\r\n        \r\n        .content {\r\n            margin-top: 10px;\r\n            display: flex;\r\n            justify-content: center;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif; /* Use Palatino Linotype font */\r\n            font-weight: normal; /* Make the text extra bold */\r\n        }\r\n        \r\n        .signature {\r\n            margin-top: 10px;\r\n            text-align: left;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif; /* Use Palatino Linotype font */\r\n            font-weight: normal; /* Make the text extra bold */\r\n        }\r\n        \r\n        .signature-name {\r\n            display: inline-block; \r\n            border-top: 1px solid black; \r\n            padding-top: 5px;\r\n            width: 250px;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif; /* Use Palatino Linotype font */\r\n            font-weight: 900; /* Make the text bold */\r\n        }\r\n        \r\n        img { \r\n            position: relative;\r\n            top: -50px;\r\n        }\r\n        \r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin: 0 auto; /* Center align table */\r\n            font-size: inherit; /* Make table font size same as body */\r\n            border-spacing: 0; /* Remove spacing between table cells */\r\n            table-layout: auto; /* Allow cell size to depend on content */\r\n        }\r\n        \r\n        th, td {\r\n            border: 1px solid transparent; /* Make borders transparent */\r\n            padding: -0px;\r\n            text-align: left;\r\n            margin: 0; /* Remove margins */\r\n            color: black; /* Set text color to black */\r\n            line-height: 0;\r\n            word-wrap: break-word; /* Allow long words to break and wrap to the next line */\r\n            white-space: normal;\r\n        }\r\n        \r\n        th {\r\n            background-color: transparent; /* Remove background color */\r\n            font-weight: bold;\r\n            text-align: center; /* Align table headers to the left */\r\n            padding: 5px; /* Adjust padding for better spacing */\r\n            color: black;\r\n        }\r\n\r\n\r\n        .underline {\r\n            border-bottom: 1px solid black; /* Add underline border */\r\n        }\r\n        \r\n    </style>\r\n</head>\r\n<body>\r\n    <div style=\"display: flex; justify-content: center;\">\r\n        <img src=\"/files/DICT%20TO%20Header.png\" alt=\"DICT Bagong Pilipinas\" style=\"margin-top: 50px;width: 60%;\">\r\n    </div>\r\n    <div class=\"header\" style=\"margin-top: -50px; text-align: center;\">\r\n        <h3 style=\"margin-top: 0px; text-align: center;\">\r\n            <span style=\"float: center; text-transform: uppercase; text-weight: bold;\">GATEPASS FOR DICT PROPERTY</span>\r\n            <br style=\"clear: both;\">\r\n        </h3>\r\n    </div>\r\n<div class=\"content\" style=\"margin-top: -50px;\">\r\n    <table class=\"table table-bordered\" style=\"border: 1px solid black; width: 100%;\">\r\n        <tr>\r\n            <td colspan=\"12\" class=\"section-title\" style=\"width: 100%; text-align: right;border: 1px solid black;\">DATE: {{ frappe.utils.formatdate(doc.transaction_date, \"MMMM dd, YYYY\") }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"12\" class=\"section-title\" style=\"width: 100%; text-align: center;border: 1px solid black; text-style: italic;\">This is to authorize the bearer of this gatepass to bring in/out to the office the following:</td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"1\" class=\"section-title\" style=\"text-align: center;border: 1px solid black;\">ITEM NO.</td>\r\n            <td colspan=\"1\" class=\"section-title\" style=\"text-align: center;border: 1px solid black;\">QTY.</td>\r\n            <td colspan=\"1\" class=\"section-title\" style=\"text-align: center;border: 1px solid black;\">UNIT</td>\r\n            <td colspan=\"9\" class=\"section-title\" style=\"text-align: center;border: 1px solid black;\"><p>DESCRIPTION</p><p style=\"font-style: italic; font-weight: normal;\">(Kindly include the brand, model, serial number if necessary and accessories included)</p></td>\r\n        </tr>\r\n{% set item_counts = {} %}\r\n{% for item in doc.gatepass_items %}\r\n    {% set item_name = item.item_name %}\r\n    {% set serial_number = item.serial_number or '' %}\r\n    {% if item_name in item_counts %}\r\n        {% set serial_list = item_counts[item_name][1] %}\r\n        {% set item_counts = item_counts.update({item_name: [item_counts[item_name][0] + 1, serial_list + [serial_number]]}) or item_counts %}\r\n    {% else %}\r\n        {% set item_counts = item_counts.update({item_name: [1, [serial_number]]}) or item_counts %}\r\n    {% endif %}\r\n{% endfor %}\r\n\r\n{% set total_items = item_counts|length %}\r\n{% set counter = namespace(value=1) %}  {# Use namespace to allow modification #}\r\n\r\n{% for item_name, data in item_counts.items() %}\r\n    <tr>\r\n        <td colspan=\"1\" style=\"border: 1px solid black;text-transform: uppercase; text-align: center;\">{{ counter.value }}</td>\r\n        <td colspan=\"1\" style=\"border: 1px solid black;text-transform: uppercase; text-align: center;\">{{ data[0] }}</td>\r\n        <td colspan=\"1\" style=\"border: 1px solid black;text-transform: uppercase; text-align: left;\"></td>\r\n        <td colspan=\"9\" style=\"border: 1px solid black;text-transform: uppercase; word-wrap: break-word; text-align: left;\">\r\n            {{ item_name }} - {% for item in doc.gatepass_items if item.item_name == item_name %}{{ item.description or '' }}{% if not loop.last %}, {% endif %}{% endfor %} <br>\r\n            S/N: {{ data[1] | join(', ') }}\r\n        </td>\r\n    </tr>\r\n    {% set counter.value = counter.value + 1 %}  {# Increment the value within the namespace #}\r\n{% endfor %}\r\n\r\n<tr>\r\n    <td colspan=\"12\" style=\"width: 100%; text-align: left; border: 1px solid black; color: black;\">\r\n        <div style=\"display: flex; flex-direction: column;\">\r\n            <div style=\"display: flex; align-items: center;\">\r\n                PURPOSE:\r\n                <span style=\"color: black; display: flex; align-items: center; margin-left: 10px; line-height: .8;\">\r\n                    <span style=\"font-size: 20px; color: #333; margin-right: 5px; position: relative; top: -2px;\">{% if doc.purpose == 'Daily Use' %}&#9679;{% else %}&#9675;{% endif %}</span> Daily Use\r\n                </span>\r\n            </div>\r\n            <span style=\"color: black; display: flex; align-items: center; margin-left: 73px; line-height: .8; position: relative;\">\r\n                <span style=\"font-size: 20px; color: #333; margin-right: 5px; position: relative; top: -2px;\">{% if doc.purpose == 'Transfer to DICT' %}&#9679;{% else %}&#9675;{% endif %}</span> Transfer to DICT\r\n                {% if doc.purpose == 'Transfer to DICT' %}\r\n                    <span style=\"margin-left: 10px; position: relative;\">\r\n                        <span style=\"text-decoration: underline;\">{{ doc.purpose_details }}</span>\r\n                        <span style=\"position: absolute; bottom: 0; left: 0; width: 50px; border-bottom: 1px solid black;\"></span>\r\n                    </span>\r\n                {% else %}\r\n                    <span style=\"position: absolute; bottom: 0; left: 120px; width: 50px; border-bottom: 1px solid black;\"></span>\r\n                {% endif %}\r\n            </span>\r\n            <span style=\"color: black; display: flex; align-items: center; margin-left: 73px; line-height: .8; position: relative;\">\r\n                <span style=\"font-size: 20px; color: #333; margin-right: 5px; position: relative; top: -2px;\">{% if doc.purpose == 'Others' %}&#9679;{% else %}&#9675;{% endif %}</span> Others\r\n                {% if doc.purpose == 'Others' %}\r\n                    <span style=\"margin-left: 10px; position: relative;\">\r\n                        <span style=\"text-decoration: underline;\">{{ doc.purpose_details }}</span>\r\n                        <span style=\"position: absolute; bottom: 0; left: 0; width: 50px; border-bottom: 1px solid black;\"></span>\r\n                    </span>\r\n                {% else %}\r\n                    <span style=\"position: absolute; bottom: 0; left: 60px; width: 50px; border-bottom: 1px solid black;\"></span>\r\n                {% endif %}\r\n            </span>\r\n        </div>\r\n    </td>\r\n</tr>\r\n\r\n    </table>\r\n</div>\r\n    <div class=\"content\" style=\"margin-top: -35px;\">\r\n        <table class=\"table table-bordered\" style=\"border: 1px solid black; width: 100%;\">\r\n                <tr>\r\n                    <td colspan=\"6\" style=\"border: 1px solid black;text-transform: uppercase; text-align: left; word-wrap: break-word;\">REQUESTED BY:</td>\r\n                    <td colspan=\"6\" style=\"border: 1px solid black;text-transform: uppercase; text-align: left; word-wrap: break-word;\">APPROVED BY:</td>\r\n                </tr>\r\n                <tr>\r\n                    <td colspan=\"6\" style=\"border: 1px solid black;text-transform: uppercase; text-align: center; word-wrap: break-word;\">\r\n                        <br><br><u><b>{{doc.requested_by}}</b></u><br><span style=\"font-weight: normal; font-style: italic; line-height: .9; text-transform: none;\">{{doc.requester_title}}{% if doc.requester_office %}, {{doc.requester_office}}{% endif %}</span>\r\n                    </td>\r\n                    <td colspan=\"6\" style=\"border: 1px solid black;text-transform: uppercase; text-align: center; word-wrap: break-word;\">\r\n                        <br><br><u><b>{{doc.approved_by}}</b></u><br><span style=\"font-weight: normal; font-style: italic; line-height: .9; text-transform: none;\">{{doc.approver_title}}{% if doc.approver_office %}, {{doc.approver_office}}{% endif %}</span>\r\n                    </td>\r\n                </tr>  \r\n<tr>\r\n    {% if doc.noted_by %}\r\n        <td colspan=\"6\" style=\"border: 1px solid black;text-transform: uppercase; text-align: left; word-wrap: break-word;\">NOTED BY:</td>\r\n        <td colspan=\"6\" style=\"border: 1px solid black;text-transform: uppercase; text-align: left; word-wrap: break-word;\">INSPECTED BY: SECURITY PERSONNEL</td>\r\n    {% else %}\r\n        <td colspan=\"12\" style=\"border: 1px solid black;text-transform: uppercase; text-align: left; word-wrap: break-word;\">INSPECTED BY: SECURITY PERSONNEL</td>\r\n    {% endif %}\r\n</tr>\r\n<tr>\r\n    {% if doc.noted_by %}\r\n        <td colspan=\"6\" style=\"border: 1px solid black;text-transform: uppercase; text-align: center; word-wrap: break-word;\">\r\n            <br><br><br><u><b>{{doc.noted_by}}</b></u><br><span style=\"font-weight: normal; font-style: italic; line-height:.9; text-transform: none;\">{{doc.noted_by_title}}{% if doc.noted_by_office %}, {{doc.noted_by_office}}{% endif %}</span>\r\n        </td>\r\n        <td colspan=\"6\" style=\"border: 1px solid black;text-transform: uppercase; text-align: left; word-wrap: break-word;\">\r\n            <br><br><br>\r\n        </td>\r\n    {% else %}\r\n        <td colspan=\"12\" style=\"border: 1px solid black;text-transform: uppercase; text-align: left; word-wrap: break-word;\">\r\n            <br><br><br>\r\n        </td>\r\n    {% endif %}\r\n</tr>\r\n                <tr>\r\n                    <td colspan=\"12\" style=\"border: 1px solid black;text-transform: uppercase; text-align: left;font-size: 10px;\">\r\n                        <i><b>DISTRIBUTION OF COPY:</b> Original - Bearer, Duplicate - Security, Tri - Asset Management Section</i>\r\n                    </td>\r\n                </tr>\r\n        </table>\r\n    </div>\r\n    {% if doc.docstatus == 0 %}\r\n    <span class=\"docstatus-draft\">DRAFT</span>\r\n    {% endif %}\r\n</body>\r\n</html>\r\n",
