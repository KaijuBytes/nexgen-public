 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;\">\r\n    <style>\r\n        @import url('https://fonts.googleapis.com/css2?family=Palatino&display=swap');\r\n\r\n        body {\r\n            font-family: 'Palatino', serif;\r\n            margin: 0;\r\n            padding: 0;\r\n            font-size: 12px;\r\n        }\r\n        .ql-editor {\r\n            font-family: 'Palatino Linotype', 'Palatino', serif !important;\r\n            margin: 0;\r\n            padding: 0;\r\n            line-height:.95;\r\n            font-weight: 300 !important;\r\n            color: black;\r\n            letter-spacing: 0.5px;\r\n        }\r\n        .docstatus-draft {\r\n            position: absolute;\r\n            top: 50%;\r\n            left: 50%;\r\n            transform: translate(-50%, -50%) rotate(-45deg);\r\n            font-size: 10rem;\r\n            color: red;\r\n            opacity: 0.5;\r\n            pointer-events: none;\r\n        }\r\n\r\n        .header {\r\n            text-align: center;\r\n            font-weight: bold;\r\n            margin-bottom: 20px;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif;\r\n            font-weight: bold;\r\n        }\r\n\r\n        .section-title {\r\n            margin-top: 20px;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif;\r\n            font-weight: bold;\r\n        }\r\n\r\n        .content {\r\n            margin-top: 10px;\r\n            display: flex;\r\n            justify-content: center;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif;\r\n            font-weight: normal;\r\n        }\r\n\r\n        .signature {\r\n            margin-top: 10px;\r\n            text-align: left;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif;\r\n            font-weight: normal;\r\n        }\r\n\r\n        .signature-name {\r\n            display: inline-block;\r\n            border-top: 1px solid black;\r\n            padding-top: 5px;\r\n            width: 250px;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif;\r\n            font-weight: 900;\r\n        }\r\n\r\n        img {\r\n            position: relative;\r\n            top: -50px;\r\n        }\r\n\r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin: 0 auto;\r\n            font-size: inherit;\r\n            border-spacing: 0;\r\n            table-layout: auto;\r\n        }\r\n\r\n        th, td {\r\n            border: 1px solid transparent;\r\n            padding: -0px;\r\n            text-align: left;\r\n            margin: 0;\r\n            color: black;\r\n            line-height: 0;\r\n            word-wrap: break-word;\r\n            white-space: normal;\r\n        }\r\n\r\n        th {\r\n            background-color: transparent;\r\n            font-weight: bold;\r\n            text-align: center;\r\n            padding: 5px;\r\n            color: black;\r\n        }\r\n\r\n        .underline {\r\n            border-bottom: 1px solid black;\r\n        }\r\n\r\n        /* Add this CSS to make checkboxes and labels black */\r\n        label {\r\n            color: black;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div style=\"display: flex; justify-content: center;\">\r\n        <img src=\"/files/DICT%20TO%20Header.png\" alt=\"DICT Bagong Pilipinas\" style=\"margin-top: 50px;width: 60%;\">\r\n    </div>\r\n    <div class=\"header\" style=\"margin-top: -50px; text-align: center;\">\r\n        <h3 style=\"margin-top: 0px; text-align: center;\">\r\n            <span style=\"float: center; text-transform: uppercase; text-weight: bold;\">ROUTING SLIP</span>\r\n            <br style=\"clear: both;\">\r\n        </h3>\r\n    </div>\r\n<table style=\"font-family: 'Palatino Linotype', 'Palatino', serif; font-weight: 900; margin-top: -30px;\">\r\n    <tr>\r\n        <td style=\"display: flex; align-items: center; justify-content: flex-end;\">\r\n            <p style=\"color: black; display: flex; align-items: center; margin-bottom: 0;\">\r\n                {% if doc.transaction_type == \"Simple\" %}\r\n                    <span style=\"font-size: 24px;\">\u2611&nbsp;</span>\r\n                {% else %}\r\n                    <span style=\"font-size: 24px;\">\u2610&nbsp;</span>\r\n                {% endif %}\r\n                SIMPLE&nbsp;&nbsp;\r\n            </p>\r\n            <p style=\"color: black; display: flex; align-items: center; margin-bottom: 0;\">\r\n                {% if doc.transaction_type == \"Complex\" %}\r\n                    <span style=\"font-size: 24px;\">\u2611&nbsp;</span>\r\n                {% else %}\r\n                    <span style=\"font-size: 24px;\">\u2610&nbsp;</span>\r\n                {% endif %}\r\n                COMPLEX&nbsp;&nbsp;\r\n            </p>\r\n            <p style=\"color: black; display: flex; align-items: center; margin-bottom: 0;\">\r\n                {% if doc.transaction_type == \"Highly Technical\" %}\r\n                    <span style=\"font-size: 24px;\">\u2611&nbsp;</span>\r\n                {% else %}\r\n                    <span style=\"font-size: 24px;\">\u2610&nbsp;</span>\r\n                {% endif %}\r\n                TECHNICAL&nbsp;&nbsp;\r\n            </p>\r\n        </td>\r\n    </tr>\r\n</table>\r\n    <table style=\"font-family: 'Palatino Linotype', 'Palatino', serif; font-weight: 900;margin-top:-20px;\">\r\n        <tr>\r\n            <td>\r\n                PROPONENT: {{ doc.from }}\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td>\r\n                CONTROL NUMBER: {{ doc.name }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n{% set logs = frappe.db.get_list(\"Document Tracker Logs\",\r\n    filters={\"dt_control_number\": doc.name, \"docstatus\": 1},\r\n    fields=[\"to\", \"date\", \"from\", \"received_by\", \"time_and_date_received\", \"remarks\"],\r\n    order_by=\"creation asc\") %}\r\n<table class=\"table table-bordered\" style=\"font-family: 'Palatino Linotype', 'Palatino', serif; border: 1px solid black; width: 100%;margin-top:-1px;\">\r\n    <tr>\r\n        <td colspan=\"12\" class=\"section-title\" style=\"width: 100%; text-align: center;border: 1px solid black; word-wrap: break-word;\">SUBJECT: {{ doc.title }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td colspan=\"1\" class=\"section-title\" style=\"text-align: center;border: 1px solid black;line-height: .8;\">Date</td>\r\n        <td colspan=\"2\" class=\"section-title\" style=\"text-align: center;border: 1px solid black;line-height: .8;\">From</td>\r\n        <td colspan=\"2\" class=\"section-title\" style=\"text-align: center;border: 1px solid black;line-height: .8;\">To</td>\r\n        <td colspan=\"4\" class=\"section-title\" style=\"text-align: center;border: 1px solid black;line-height: .8;\">Recommendations / Instructions</td>\r\n        <td colspan=\"3\" class=\"section-title\" style=\"text-align: center;border: 1px solid black;line-height: .8;\"><p>Received by:</p><p style=\"font-weight: normal;\">(with date & time)</p></td>\r\n    </tr>\r\n    {% for log in logs %}\r\n    <tr>\r\n        <td colspan=\"1\" style=\"border: 1px solid black; text-transform: uppercase; text-align: center; line-height: .8;word-wrap: break-word;\">\r\n            <div style=\"display: flex; align-items: center; justify-content: center; height: 100%;\">{{ log.date.strftime('%d %b %Y') }}</div>\r\n        </td>\r\n        <td colspan=\"2\" style=\"border: 1px solid black; text-transform: uppercase; text-align: center; line-height: .8;\">\r\n            <div style=\"display: flex; align-items: center; justify-content: center; height: 100%;\">{{ log.from }}</div>\r\n        </td>\r\n        <td colspan=\"2\" style=\"border: 1px solid black; text-transform: uppercase; text-align: center; line-height: .8;\">\r\n            <div style=\"display: flex; align-items: center; justify-content: center; height: 100%;\">{{ log.to }}</div>\r\n        </td>\r\n        <td colspan=\"4\" style=\"border: 1px solid black; text-transform: none; text-align: left; line-height: .8;\">\r\n            <div style=\"display: flex; align-items: center; height: 100%;\">{{ log.remarks or '' | safe }}</div>\r\n        </td>\r\n        <td colspan=\"3\" style=\"border: 1px solid black; text-transform: none; text-align: center; line-height: 1;\">\r\n            <div style=\"display: flex; align-items: center; justify-content: center; height: 100%;\">\r\n                {{ log.received_by or '' }}<br>\r\n                {% if log.time_and_date_received %}\r\n                    {{ log.time_and_date_received.strftime('%d %b %Y %H:%M').upper() }}\r\n                {% endif %}\r\n            </div>\r\n        </td>\r\n    </tr>\r\n    {% endfor %}\r\n\r\n    {% set rows_needed = doc.extra_rows - logs|length %}\r\n    {% if rows_needed > 0 %}\r\n        {% for i in range(rows_needed) %}\r\n            <tr>\r\n                <td colspan=\"1\" style=\"border: 1px solid black; text-align: center; line-height: .8;\">\r\n                    <div style=\"display: flex; align-items: center; justify-content: center; height: 100%;\">&nbsp;</div>\r\n                </td>\r\n                <td colspan=\"2\" style=\"border: 1px solid black; text-align: center; line-height: .8;\">\r\n                    <div style=\"display: flex; align-items: center; justify-content: center; height: 100%;\">&nbsp;</div>\r\n                </td>\r\n                <td colspan=\"2\" style=\"border: 1px solid black; text-align: center; line-height: .8;\">\r\n                    <div style=\"display: flex; align-items: center; justify-content: center; height: 100%;\">&nbsp;</div>\r\n                </td>\r\n                <td colspan=\"4\" style=\"border: 1px solid black; text-align: left; line-height: .8;\">\r\n                    <div style=\"display: flex; align-items: center; height: 100%;\">&nbsp;</div>\r\n                </td>\r\n                <td colspan=\"3\" style=\"border: 1px solid black; text-align: center; line-height: 1;\">\r\n                    <div style=\"display: flex; align-items: center; justify-content: center; height: 100%;\">&nbsp;</div>\r\n                </td>\r\n            </tr>\r\n        {% endfor %}\r\n    {% endif %}\r\n</table>\r\n<table class=\"table table-bordered\" style=\"font-family: 'Palatino Linotype', 'Palatino', serif; border: 1px solid black; width: 100%;margin-top:-18px;\">\r\n            <tr>\r\n            <td colspan=\"12\" style=\"font-size: 10px; border: 1px solid black;\">\r\n                <b>Reminder:</b><br>\r\nUnder Section 5 of RA 6713, known as the \u201cCode of Conduct and Ethical Standards for Public Officials and Employees,\u201d public officials and employees must act promptly on letters and requests, and must respond to letters or communications within fifteen (15) working days from receipt thereof. The reply must contain the action taken on the request. Likewise, all official papers and documents must be processed and completed within a reasonable time. Under Section 8 of Republic Act 9485, known as the \u201cAnti-Red Tape Act,\u201d applications or request for frontline services shall be acted upon within five (5) days for simple transactions or ten (10) days for complex transactions, as defined in the Citizen\u2019s Charter.\r\n\r\n            </td>\r\n        </tr>\r\n</table>\r\n<table class=\"table\" style=\"font-family: Calibri, sans-serif; border-top: 2px solid #114991; width: 100%; margin-top: -10px; color: #114991;\">\r\n    <tr>\r\n        <td colspan=\"12\" style=\"font-size: 12px; text-align: center; padding: 0px 0; color: #114991;\">\r\n            Carlos P. Garcia Avenue, Diliman, Quezon City, 1101 Metro Manila, Philippines<br>\r\n            +632 8920-0101 | www.dict.gov.ph\r\n        </td>\r\n    </tr>\r\n</table>\r\n\r\n\r\n</body>\r\n</html>",
