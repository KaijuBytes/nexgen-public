 "font_size": 14,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com;\">\r\n    <style>\r\n        @import url('https://fonts.googleapis.com/css2?family=Palatino&display=swap');\r\n        \r\n        body {\r\n            font-family: 'Palatino', serif;\r\n            margin: 0;\r\n            padding: 0;\r\n            font-size: 12px; /* Adjust this size to match your desired body font size */\r\n        }\r\n        .docstatus-draft {\r\n            position: absolute;\r\n            top: 50%;\r\n            left: 50%;\r\n            transform: translate(-50%, -50%) rotate(-45deg);\r\n            font-size: 10rem;\r\n            color: red;\r\n            opacity: 0.5;\r\n            pointer-events: none;\r\n        }\r\n        \r\n        \r\n        .header {\r\n            text-align: center;\r\n            font-weight: bold;\r\n            margin-bottom: 20px;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif; /* Use Palatino Linotype font */\r\n            font-weight: bold; /* Make the text extra bold */\r\n        }\r\n        \r\n        .section-title {\r\n            /*font-weight: bold;*/\r\n            margin-top: 20px;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif; /* Use Palatino Linotype font */\r\n            font-weight: bold; /* Make the text extra bold */\r\n        }\r\n        \r\n        .content {\r\n            margin-top: 10px;\r\n            display: flex;\r\n            justify-content: center;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif; /* Use Palatino Linotype font */\r\n            font-weight: normal; /* Make the text extra bold */\r\n        }\r\n        \r\n        .signature {\r\n            margin-top: 10px;\r\n            text-align: left;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif; /* Use Palatino Linotype font */\r\n            font-weight: normal; /* Make the text extra bold */\r\n        }\r\n        \r\n        .signature-name {\r\n            display: inline-block; \r\n            border-top: 1px solid black; \r\n            padding-top: 5px;\r\n            width: 250px;\r\n            font-family: 'Palatino Linotype', 'Palatino', serif; /* Use Palatino Linotype font */\r\n            font-weight: 900; /* Make the text bold */\r\n        }\r\n        \r\n        img { \r\n            position: relative;\r\n            top: -50px;\r\n        }\r\n        \r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin: 0 auto; /* Center align table */\r\n            font-size: inherit; /* Make table font size same as body */\r\n            border-spacing: 0; /* Remove spacing between table cells */\r\n            table-layout: auto; /* Allow cell size to depend on content */\r\n        }\r\n        \r\n        th, td {\r\n            border: 1px solid transparent; /* Make borders transparent */\r\n            padding: -0px;\r\n            text-align: left;\r\n            margin: 0; /* Remove margins */\r\n            color: black; /* Set text color to black */\r\n            line-height: 0;\r\n            word-wrap: break-word; /* Allow long words to break and wrap to the next line */\r\n            white-space: normal;\r\n        }\r\n        \r\n        th {\r\n            background-color: transparent; /* Remove background color */\r\n            font-weight: bold;\r\n            text-align: center; /* Align table headers to the left */\r\n            padding: 5px; /* Adjust padding for better spacing */\r\n            color: black;\r\n        }\r\n\r\n\r\n        .underline {\r\n            border-bottom: 1px solid black; /* Add underline border */\r\n        }\r\n        \r\n    </style>\r\n</head>\r\n<body>\r\n    <div style=\"display: flex; justify-content: center;\">\r\n        <img src=\"/files/DICT%20TO%20Header.png\" alt=\"DICT Bagong Pilipinas\" style=\"margin-top: 50px;width: 60%;\">\r\n    </div>\r\n    <div class=\"header\">\r\n            <p style=\"margin-top: 0px; text-align: center;\">\r\n                <span style=\"float: center; text-transform: uppercase; text-decoration: underline;\">AUTHORIZATION</span>\r\n                <br style=\"clear: both;\">\r\n            </p>\r\n    </div>\r\n    <div class=\"content\" style=\"text-align: justify; margin-top: -10px; font-style: normal; font-weight: lighter;\">\r\n<p>This is to authorize the personnel under the <b>{{ doc.division }}</b> of the <b>{{ doc.bureauservices}}</b> to use {% if doc.gender == \"Male\" %}his{% elif doc.gender == \"Female\" %}her{% else %}their{% endif %} Compensatory Overtime Credits earned last <b>{% if doc.get(\"reference_dates\") %}{% for ref_date in doc.get(\"reference_dates\") %}\r\n    {{ frappe.utils.formatdate(ref_date.get(\"date\"), \"MMMM dd, YYYY\") }}\r\n    {% if not loop.last %}{% if loop.index == loop.length - 1 %} and {% else %}, {% endif %}{% endif %}\r\n{% endfor %}{% endif %}</b> on the stated date below, pursuant to Civil Service Commission and Department of Budget and Management Joint Circular No. 2 s.2004, as amended.</p>\r\n    </div>\r\n    <div class=\"content\" style=\"margin-top: 20px;\">\r\n        <table class=\"table table-bordered\" style=\"border: 1px solid black;\">\r\n                <tr>\r\n                    <td class=\"section-title\" style=\"width: 32%; text-align: center;border: 1px solid black;\">Name</th>\r\n                    <td class=\"section-title\" style=\"width: 32%; text-align: center;border: 1px solid black;\">Position</th>\r\n                    <td class=\"section-title\" style=\"width: 32%; text-align: center;border: 1px solid black;\">Date of CTO</th>\r\n                </tr>\r\n                <tr>\r\n                <td style=\"border: 1px solid black;text-transform: uppercase; text-align: center;\">{{ doc.name_of_the_requester }}</td>\r\n                <td style=\"border: 1px solid black;text-transform: uppercase; text-align: center;\">{{ doc.position_title }}</td>\r\n                <td style=\"border: 1px solid black;text-transform: uppercase; word-wrap: break-word; text-align: center;\">\r\n                    {{ frappe.utils.formatdate(doc.from_date, \"MMMM dd, YYYY\") }}\r\n                    {% if doc.to_date %}\r\n                        <br> - {{ frappe.utils.formatdate(doc.to_date, \"MMMM dd, YYYY\") }}\r\n                    {% endif %}\r\n                    {% if doc.cto_hours %}\r\n                        <br> ({{ doc.cto_hours }} HOURS ONLY)\r\n                    {% endif %}\r\n                </td>\r\n                </tr>\r\n        </table>\r\n    </div>\r\n    \r\n    <div class=\"content\" style=\"text-align: justify; margin-top: 10px; font-style: normal; font-weight: lighter;\">This authorization shall be used as an attachment to the above-mentioned employee\u2019s Daily Time Record (DTR) for the payroll period.</div>\r\n    <br><br><br>\r\n    <table>\r\n            <tr>\r\n                <td class=\"section-title\" style=\"width: 64%; text-align: left;\">Date Requested: {{ frappe.utils.formatdate(doc.date_requested, \"MMMM dd, YYYY\") }}</td>\r\n                <td style=\"width: 2%;\"></td>\r\n                <td style=\"width: 2%;\"></td>\r\n                <td class=\"signature-name\" style=\"text-align: center; text-transform: uppercase;word-wrap: break-word; line-height: 1;\">{{doc.leave_approver}}<br><span style=\"font-weight: normal;font-style: italic; line-height: .9; text-transform: none;\">{{doc.approver_position_title}}{% if doc.approver_office %}, <br>{{doc.approver_office}}\r\n                    {% endif %}</span></td>\r\n            </tr>\r\n    </table>\r\n    {% if doc.docstatus == 0 %}\r\n    <span class=\"docstatus-draft\">DRAFT</span>\r\n    {% endif %}\r\n</body>\r\n</html>\r\n",
